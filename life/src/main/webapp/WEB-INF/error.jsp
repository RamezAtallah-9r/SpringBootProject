<%@ taglib prefix="c" uri="jakarta.tags.core"%>

<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Error | LifeBeacon</title><script src="https://cdn.tailwindcss.com"></script></head><body class="min-h-screen bg-emerald-50 grid place-items-center p-5"><main class="w-full max-w-xl rounded-3xl bg-white p-10 text-center shadow-xl border border-emerald-100"><div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-red-50 text-3xl">!</div><h1 class="text-3xl font-black text-slate-800"><c:out value="${errorTitle}" default="Something went wrong"/></h1><p class="mt-4 text-slate-600"><c:out value="${errorMessage}" default="Please return to the dashboard and try again."/></p><div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center"><a class="rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white" href="<c:url value='/dashboard' />">Go to dashboard</a><a class="rounded-xl border border-slate-200 px-5 py-3 font-bold text-slate-700" href="<c:url value='/' />">Go home</a></div></main></body></html>